generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // DATABASE_URL usa pgBouncer (puerto 6543) → para queries normales
  url       = env("DATABASE_URL")
  // DIRECT_URL usa conexión directa (puerto 5432) → para migraciones
  directUrl = env("DIRECT_URL")
}

model Sucursal {
  id          Int    @id @default(autoincrement())
  nombre      String
  direccion   String?
  telefono    String?
  usuarios       Usuario[]
  facturas       FacturaDte[]
  stocks         StockSucursal[]
  recepciones    RecepcionMercancia[]
  zonasEnvio     ZonaEnvio[]
  pedidosOnline  PedidoOnline[]
  cortesCaja  CorteCaja[]
  @@map("sucursales")
}

model Categoria {
  id          Int    @id @default(autoincrement())
  nombre      String @unique
  descripcion String?
  activo      Boolean @default(true)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")
  productos   Producto[]
  @@map("categorias")
}

model Usuario {
  id             Int      @id @default(autoincrement())
  sucursalId     Int?     @map("sucursal_id")
  nombre         String
  email          String   @unique
  contrasenaHash String   @map("contrasena_hash")
  rol            String
  activo         Boolean  @default(true)
  creadoEn       DateTime @default(now()) @map("creado_en")
  sucursal       Sucursal?    @relation(fields: [sucursalId], references: [id])
  facturas       FacturaDte[]
  syncLogs       SyncLog[]
  recepciones    RecepcionMercancia[]
  cortesCaja     CorteCaja[]
  @@map("usuarios")
}

model Producto {
  id                 Int      @id @default(autoincrement())
  categoriaId        Int?     @map("categoria_id")
  nombre             String
  codigoBarras       String?  @unique @map("codigo_barras")
  tipoUnidad         String?  @map("tipo_unidad")
  precioCompra       Float?   @map("precio_compra")
  porcentajeGanancia Float?   @map("porcentaje_ganancia")
  precioVenta        Float?   @map("precio_venta")
  precioConIva       Float?   @map("precio_con_iva")
  tieneIva           Boolean  @default(true) @map("tiene_iva")
  stockActual        Int      @default(0) @map("stock_actual")
  stockMinimo        Int      @default(0) @map("stock_minimo")
  activo             Boolean  @default(true)
  creadoEn           DateTime @default(now()) @map("creado_en")
  updatedAt          DateTime @default(now()) @updatedAt @map("updated_at")
  categoria          Categoria?    @relation(fields: [categoriaId], references: [id])
  detallesVenta         DetalleVenta[]
  stocks                StockSucursal[]
  detallesRecepcion     DetalleRecepcion[]
  detallesPedidoOnline  PedidoOnlineDetalle[]
  @@map("productos")
}

model StockSucursal {
  id            Int      @id @default(autoincrement())
  productoId    Int      @map("producto_id")
  sucursalId    Int      @map("sucursal_id")
  cantidad        Int      @default(0)
  minimo          Int      @default(0)
  stockReservado  Int      @default(0) @map("stock_reservado")
  actualizadoEn   DateTime @default(now()) @updatedAt @map("actualizado_en")
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at")
  producto      Producto  @relation(fields: [productoId], references: [id])
  sucursal      Sucursal  @relation(fields: [sucursalId], references: [id])
  @@unique([productoId, sucursalId])
  @@map("stock_sucursal")
}

model FacturaDte {
  id               Int      @id @default(autoincrement())
  sucursalId       Int?     @map("sucursal_id")
  usuarioId        Int?     @map("usuario_id")
  codigoGeneracion String?  @unique @map("codigo_generacion")
  numeroControl    String?  @unique @map("numero_control")
  tipoDte          String   @default("01") @map("tipo_dte")
  clienteNombre    String   @default("Consumidor Final") @map("cliente_nombre")
  totalSinIva      Float?   @map("total_sin_iva")
  iva              Float?
  total            Float?
  dteJson          String?  @map("dte_json")
  estado           String   @default("SIMULADO")
  sincronizado     Boolean  @default(true)
  creadoEn         DateTime @default(now()) @map("creado_en")
  sucursal         Sucursal?    @relation(fields: [sucursalId], references: [id])
  usuario          Usuario?     @relation(fields: [usuarioId], references: [id])
  detalles         DetalleVenta[]
  @@map("facturas_dte")
}

model DetalleVenta {
  id         Int   @id @default(autoincrement())
  facturaId  Int   @map("factura_id")
  productoId Int   @map("producto_id")
  cantidad   Float
  precioUnit Float @map("precio_unit")
  subtotal   Float
  factura    FacturaDte @relation(fields: [facturaId], references: [id])
  producto   Producto   @relation(fields: [productoId], references: [id])
  @@map("detalles_venta")
}

model SyncLog {
  id        Int       @id @default(autoincrement())
  usuarioId Int?      @map("usuario_id")
  tabla     String
  operacion String
  payload   String
  status    String    @default("PENDIENTE")
  intentos  Int       @default(0)
  error     String?
  creadoEn  DateTime  @default(now()) @map("creado_en")
  sincEn    DateTime? @map("sinc_en")
  usuario   Usuario?  @relation(fields: [usuarioId], references: [id])
  // DT-21: índice para el loop de drenaje (pushPendientes filtra por status)
  @@index([tabla, status])
  @@map("sync_log")
}

// ── HU-10: Corte de caja (X, Y, Z) ─────────────────────────────

model CorteCaja {
  id                 Int       @id @default(autoincrement())
  sucursalId         Int       @map("sucursal_id")
  cajeroId           Int?      @map("cajero_id")
  tipo               String
  fechaInicio        DateTime  @map("fecha_inicio")
  fechaFin           DateTime  @map("fecha_fin")
  totalEfectivo      Float     @default(0) @map("total_efectivo")
  totalTarjeta       Float     @default(0) @map("total_tarjeta")
  totalTransferencia Float     @default(0) @map("total_transferencia")
  totalGeneral       Float     @default(0) @map("total_general")
  cantidadVentas     Int       @default(0) @map("cantidad_ventas")
  observaciones      String?
  creadoEn           DateTime  @default(now()) @map("creado_en")
  sucursal           Sucursal  @relation(fields: [sucursalId], references: [id])
  cajero             Usuario?  @relation(fields: [cajeroId], references: [id])
  @@index([sucursalId, tipo, fechaFin])
  @@map("cortes_caja")
}

// HU-14: Recepción de mercancía de proveedores
model Proveedor {
  id          Int      @id @default(autoincrement())
  nombre      String
  nit         String?  @unique
  telefono    String?
  email       String?
  direccion   String?
  activo      Boolean  @default(true)
  creadoEn    DateTime @default(now()) @map("creado_en")
  recepciones RecepcionMercancia[]
  @@map("proveedores")
}

model RecepcionMercancia {
  id             Int      @id @default(autoincrement())
  proveedorId    Int      @map("proveedor_id")
  sucursalId     Int      @map("sucursal_id")
  usuarioId      Int?     @map("usuario_id")
  numeroFactura  String?  @map("numero_factura")
  total          Float    @default(0)
  observaciones  String?
  creadoEn       DateTime @default(now()) @map("creado_en")
  proveedor      Proveedor          @relation(fields: [proveedorId], references: [id])
  sucursal       Sucursal           @relation(fields: [sucursalId], references: [id])
  usuario        Usuario?           @relation(fields: [usuarioId], references: [id])
  detalles       DetalleRecepcion[]
  @@map("recepciones_mercancia")
}

model DetalleRecepcion {
  id          Int   @id @default(autoincrement())
  recepcionId Int   @map("recepcion_id")
  productoId  Int   @map("producto_id")
  cantidad    Float
  costoUnit   Float @map("costo_unit")
  subtotal    Float
  recepcion   RecepcionMercancia @relation(fields: [recepcionId], references: [id], onDelete: Cascade)
  producto    Producto           @relation(fields: [productoId], references: [id])
  @@map("detalles_recepcion")
}

// ── HU-16: Ecommerce ────────────────────────────────────────────

model ZonaEnvio {
  id                 Int       @id @default(autoincrement())
  nombre             String
  descripcion        String?
  sucursalPreferente Int?      @map("sucursal_id_preferente")
  costoEnvio         Float     @default(0) @map("costo_envio")
  activo             Boolean   @default(true)
  sucursal           Sucursal? @relation(fields: [sucursalPreferente], references: [id])
  pedidos            PedidoOnline[]
  @@map("zonas_envio")
}

model PedidoOnline {
  id             Int      @id @default(autoincrement())
  clienteId      Int?     @map("cliente_id")
  sucursalId     Int      @map("sucursal_id")
  zonaEnvioId    Int?     @map("zona_envio_id")
  tipoEntrega    String   @default("RETIRO") @map("tipo_entrega")
  estado         String   @default("RECIBIDO")
  clienteNombre  String?  @map("cliente_nombre")
  clienteTel     String?  @map("cliente_tel")
  direccionEnvio String?  @map("direccion_envio")
  subtotal       Float    @default(0)
  costoEnvio     Float    @default(0) @map("costo_envio")
  total          Float    @default(0)
  observaciones  String?
  creadoEn       DateTime @default(now()) @map("creado_en")
  actualizadoEn  DateTime @default(now()) @updatedAt @map("actualizado_en")
  sucursal       Sucursal   @relation(fields: [sucursalId], references: [id])
  zonaEnvio      ZonaEnvio? @relation(fields: [zonaEnvioId], references: [id])
  detalles       PedidoOnlineDetalle[]
  @@index([sucursalId, estado])
  @@index([clienteId])
  @@map("pedidos_online")
}

model PedidoOnlineDetalle {
  id         Int    @id @default(autoincrement())
  pedidoId   Int    @map("pedido_id")
  productoId Int    @map("producto_id")
  cantidad   Float
  precioUnit Float  @map("precio_unit")
  subtotal   Float
  pedido     PedidoOnline @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  producto   Producto     @relation(fields: [productoId], references: [id])
  @@map("pedidos_online_detalle")
}
